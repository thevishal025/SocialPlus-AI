# ====================================================
# SOCIALPULSE AI - CENTRAL CONFIGURATION (EXAMPLE)
# ====================================================

# APPLICATION
APP_NAME=SocialPulse AI
DEBUG=true
FRONTEND_ORIGIN=http://localhost:5173

# YOUTUBE API
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY

# RAPIDAPI INSTAGRAM
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY
RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com
RAPIDAPI_MCP_URL=https://mcp.rapidapi.com
INSTAGRAM_PROVIDER_NAME=Instagram Scraper Stable API

# META OFFICIAL INSTAGRAM GRAPH API (METHOD 1)
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN
META_INSTAGRAM_USER_ID=YOUR_META_INSTAGRAM_USER_ID
META_GRAPH_API_VERSION=v21.0
META_API_ENABLED=false

# DATABASE
DATABASE_URL=sqlite:///./socialpulse.db
POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/socialpulse

# SECURITY
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
